[Unit]
Description=Conan Exiles backup.
Requires=conan_exiles_backup.timer
After=network.target
Wants=network.target

[Service]
Type=simple
RestartSec=5s
ExecStart=/bin/bash -c '/usr/bin/tar -cvJf "{{ conan_exiles__cfg._backup_dir }}/$(date --iso-8601).tar.xz" "{{ conan_exiles__cfg._save_dir }}" "{{ conan_exiles__cfg._mod_dir if conan_exiles_flg_backup else '' }}"'
WorkingDirectory={{ conan_exiles__cfg._root_dir }}
User={{ steam__ctx._user }}
Group={{ steam__ctx._group }}

[Install]
WantedBy=multi-user.target